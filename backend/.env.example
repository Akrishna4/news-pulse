# News Pulse — backend environment template

# Neon Postgres connection string. Must include sslmode=require.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Port Express listens on. Render sets this automatically in production.
PORT=4000

# development | production
NODE_ENV=development

# Exact origin allowed by CORS. Local dev uses the Next.js dev server origin;
# production must be set to the exact deployed Vercel URL (no wildcard).
ALLOWED_ORIGIN=http://localhost:3000
