# News Pulse — scraper environment template
# In production this is inherited from the Node process (child_process.spawn
# passes process.env through) rather than read from a .env file directly.
# This file is for local/manual runs of the scraper only.

# Neon Postgres connection string. Must include sslmode=require.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
